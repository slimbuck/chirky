[Unit]
Description=Chirky CRT game host
After=local-fs.target

[Service]
Type=simple
User=retro
Group=retro
SupplementaryGroups=video render input audio
WorkingDirectory=/home/retro/chirky
ExecStart=/home/retro/chirky/build/chirky-host
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
StandardOutput=append:/home/retro/chirky/run/chirky.log
StandardError=append:/home/retro/chirky/run/chirky.log

[Install]
WantedBy=multi-user.target
