{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Chirky.org private static origin, CloudFront HTTPS, and GitHub publishing role. Deploy in us-east-1.",
  "Parameters": {
    "CertificateArn": {"Type":"String","AllowedPattern":"arn:aws:acm:us-east-1:[0-9]{12}:certificate/.+","Description":"Issued ACM certificate covering chirky.org in us-east-1"},
    "HostedZoneId": {"Type":"String","Default":"","Description":"Existing public Route 53 zone for chirky.org; leave empty for external DNS"}
  },
  "Conditions": {"ManageDNS":{"Fn::Not":[{"Fn::Equals":[{"Ref":"HostedZoneId"},""]}]}},
  "Resources": {
    "SiteBucket": {
      "Type":"AWS::S3::Bucket","DeletionPolicy":"Retain","UpdateReplacePolicy":"Retain",
      "Properties": {
        "BucketName":{"Fn::Sub":"chirky-org-${AWS::AccountId}"},
        "OwnershipControls":{"Rules":[{"ObjectOwnership":"BucketOwnerEnforced"}]},
        "PublicAccessBlockConfiguration":{"BlockPublicAcls":true,"BlockPublicPolicy":true,"IgnorePublicAcls":true,"RestrictPublicBuckets":true},
        "BucketEncryption":{"ServerSideEncryptionConfiguration":[{"ServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]},
        "VersioningConfiguration":{"Status":"Enabled"},
        "LifecycleConfiguration":{"Rules":[{"Id":"OldVersions","Status":"Enabled","NoncurrentVersionExpiration":{"NoncurrentDays":30}}]}
      }
    },
    "OriginAccess": {
      "Type":"AWS::CloudFront::OriginAccessControl",
      "Properties":{"OriginAccessControlConfig":{"Name":{"Fn::Sub":"${AWS::StackName}-origin"},"OriginAccessControlOriginType":"s3","SigningBehavior":"always","SigningProtocol":"sigv4"}}
    },
    "Distribution": {
      "Type":"AWS::CloudFront::Distribution",
      "Properties":{"DistributionConfig":{
        "Enabled":true,"Comment":"Chirky.org browser console","Aliases":["chirky.org"],"DefaultRootObject":"index.html","HttpVersion":"http2and3","IPV6Enabled":true,"PriceClass":"PriceClass_100",
        "Origins":[{"Id":"ChirkyS3","DomainName":{"Fn::GetAtt":["SiteBucket","RegionalDomainName"]},"OriginAccessControlId":{"Fn::GetAtt":["OriginAccess","Id"]},"S3OriginConfig":{"OriginAccessIdentity":""}}],
        "DefaultCacheBehavior":{"TargetOriginId":"ChirkyS3","ViewerProtocolPolicy":"redirect-to-https","AllowedMethods":["GET","HEAD","OPTIONS"],"CachedMethods":["GET","HEAD"],"Compress":true,"CachePolicyId":"4135ea2d-6df8-44a3-9df3-4b5a84be39ad"},
        "ViewerCertificate":{"AcmCertificateArn":{"Ref":"CertificateArn"},"SslSupportMethod":"sni-only","MinimumProtocolVersion":"TLSv1.2_2021"}
      }}
    },
    "BucketPolicy": {
      "Type":"AWS::S3::BucketPolicy",
      "Properties":{"Bucket":{"Ref":"SiteBucket"},"PolicyDocument":{"Version":"2012-10-17","Statement":[
        {"Sid":"CloudFrontReadOnly","Effect":"Allow","Principal":{"Service":"cloudfront.amazonaws.com"},"Action":"s3:GetObject","Resource":{"Fn::Sub":"${SiteBucket.Arn}/*"},"Condition":{"StringEquals":{"AWS:SourceArn":{"Fn::Sub":"arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"}}}},
        {"Sid":"RequireTLS","Effect":"Deny","Principal":"*","Action":"s3:*","Resource":[{"Fn::GetAtt":["SiteBucket","Arn"]},{"Fn::Sub":"${SiteBucket.Arn}/*"}],"Condition":{"Bool":{"aws:SecureTransport":"false"}}}
      ]}}
    },
    "PublishRole": {
      "Type":"AWS::IAM::Role",
      "Properties":{
        "AssumeRolePolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Federated":{"Fn::Sub":"arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"}},"Action":"sts:AssumeRoleWithWebIdentity","Condition":{"StringEquals":{"token.actions.githubusercontent.com:aud":"sts.amazonaws.com","token.actions.githubusercontent.com:sub":"repo:slimbuck@11276292/chirky@1352099473:ref:refs/heads/main"}}}]},
        "Policies":[{"PolicyName":"PublishChirky","PolicyDocument":{"Version":"2012-10-17","Statement":[
          {"Effect":"Allow","Action":["s3:ListBucket","s3:GetBucketLocation"],"Resource":{"Fn::GetAtt":["SiteBucket","Arn"]}},
          {"Effect":"Allow","Action":["s3:GetObject","s3:PutObject"],"Resource":{"Fn::Sub":"${SiteBucket.Arn}/*"}},
          {"Effect":"Allow","Action":["cloudfront:GetDistributionConfig","cloudfront:CreateInvalidation","cloudfront:GetInvalidation"],"Resource":{"Fn::Sub":"arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"}}
        ]}}]
      }
    },
    "DNSv4":{"Type":"AWS::Route53::RecordSet","Condition":"ManageDNS","Properties":{"HostedZoneId":{"Ref":"HostedZoneId"},"Name":"chirky.org","Type":"A","AliasTarget":{"DNSName":{"Fn::GetAtt":["Distribution","DomainName"]},"HostedZoneId":"Z2FDTNDATAQYW2","EvaluateTargetHealth":false}}},
    "DNSv6":{"Type":"AWS::Route53::RecordSet","Condition":"ManageDNS","Properties":{"HostedZoneId":{"Ref":"HostedZoneId"},"Name":"chirky.org","Type":"AAAA","AliasTarget":{"DNSName":{"Fn::GetAtt":["Distribution","DomainName"]},"HostedZoneId":"Z2FDTNDATAQYW2","EvaluateTargetHealth":false}}}
  },
  "Outputs": {
    "Bucket":{"Value":{"Ref":"SiteBucket"}},
    "DistributionId":{"Value":{"Ref":"Distribution"}},
    "CloudFrontDomain":{"Value":{"Fn::GetAtt":["Distribution","DomainName"]}},
    "PublishRoleArn":{"Value":{"Fn::GetAtt":["PublishRole","Arn"]}},
    "URL":{"Value":"https://chirky.org/"}
  }
}
